# Copy this file to .env on the VPS and replace every CHANGE_ME value.

COMPOSE_PROJECT_NAME=recycling-incentive

POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=recycling_incentive_backend
POSTGRES_USER=recycling_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
BACKEND_APP_NAME="Recycling Incentive API"
BACKEND_APP_ENV=production
BACKEND_APP_KEY=CHANGE_ME_STABLE_LARAVEL_APP_KEY
BACKEND_APP_DEBUG=false
BACKEND_APP_URL=https://ria-api.beytullahp.com
BACKEND_RUN_MIGRATIONS=true
BACKEND_RUN_SEEDERS=true
BACKEND_SESSION_DRIVER=database
BACKEND_SESSION_DOMAIN=.beytullahp.com
BACKEND_SESSION_SECURE_COOKIE=true

SANCTUM_STATEFUL_DOMAINS=ria-admin.beytullahp.com
CORS_ALLOWED_ORIGINS=https://ria-admin.beytullahp.com,https://ria-expo.beytullahp.com
CORS_ALLOWED_ORIGINS_PATTERNS=

SEED_ADMIN_EMAIL=admin@recycling.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SEED_USER_EMAIL=user@recycling.com
SEED_USER_PASSWORD=CHANGE_ME_STRONG_USER_PASSWORD

ADMIN_FRONTEND_BIND_ADDRESS=127.0.0.1
ADMIN_FRONTEND_PORT=5173
ADMIN_VITE_API_URL=https://ria-api.beytullahp.com

# Expo here is a development Metro server, not a production mobile release.
EXPO_BIND_ADDRESS=127.0.0.1
EXPO_METRO_PORT=8081
EXPO_PORT_19000=19000
EXPO_PORT_19001=19001
EXPO_PORT_19002=19002
EXPO_PUBLIC_API_URL=https://ria-api.beytullahp.com/api
EXPO_PACKAGER_HOSTNAME=ria-expo.beytullahp.com
