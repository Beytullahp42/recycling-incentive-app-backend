# Docker Compose project
COMPOSE_PROJECT_NAME=recycling-incentive

# PostgreSQL
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=recycling_incentive_backend
POSTGRES_USER=recycling_user
POSTGRES_PASSWORD=recycling_password

# Laravel API
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000
BACKEND_APP_NAME="Recycling Incentive API"
BACKEND_APP_ENV=local
BACKEND_APP_KEY=
BACKEND_APP_DEBUG=true
BACKEND_APP_URL=http://localhost:8000
BACKEND_RUN_MIGRATIONS=true
BACKEND_RUN_SEEDERS=true
BACKEND_SESSION_DRIVER=database
BACKEND_SESSION_DOMAIN=null
BACKEND_SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,localhost:8000,127.0.0.1:8000,::1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOWED_ORIGINS_PATTERNS=

# Optional seed credentials, used when BACKEND_RUN_SEEDERS=true or when running db:seed manually.
SEED_ADMIN_EMAIL=admin@recycling.com
SEED_ADMIN_PASSWORD=password
SEED_USER_EMAIL=user@recycling.com
SEED_USER_PASSWORD=password

# Admin Vite app
ADMIN_FRONTEND_BIND_ADDRESS=0.0.0.0
ADMIN_FRONTEND_PORT=5173
ADMIN_VITE_API_URL=http://localhost:8000

# Expo / Metro
EXPO_BIND_ADDRESS=0.0.0.0
EXPO_METRO_PORT=8081
EXPO_PORT_19000=19000
EXPO_PORT_19001=19001
EXPO_PORT_19002=19002
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# When scanning the Expo QR code from a physical phone, use your machine's LAN IP
# here and in EXPO_PUBLIC_API_URL, for example http://192.168.1.25:8000/api.
EXPO_PACKAGER_HOSTNAME=localhost
